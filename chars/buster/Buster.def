; Definition file for Buster
; Contains all the filenames needed for the character

; Player information
[Info] 
name = "Straight Buster"    ;Name of character, change to Terry if you want Geese to interact with him properly, but screw it.
displayname = "Buster"      ;Name of character to display
versiondate = 08,24,2016    ;Version date of character (MM-DD-YYYY or X.XX) ;Production started at 03,24,2015
mugenversion = 1.0          ;Version of M.U.G.E.N character works on (X.XX)
author = "Brergrsart"       ;Character author name
pal.defaults = 1,2,3,4      ;Default palettes in order of preference (up to 4)
                            ;Numbering starts from 1
localcoord = 320,240        ;Local coordinate space width and height

; Files for the player
[Files]
cmd     = Buster.cmd           ;Command set
cns     = Buster.cns           ;Constants
st      = Buster.cns           ;States
stcommon = common1.cns      ;Common states (from data/ or motif)
sprite  = Buster.sff           ;Sprite
anim    = Buster.air           ;Animation
sound   = Buster.snd           ;Sound


; Maps character selection buttons to palette numbers.
[Palette Keymap]
a = 1 ;Press button X to select palette 1, etc.
b = 2
c = 3
x = 4
y = 5
z = 6
;x2 = 7 ;Hold Start and press button X for palette 7, etc.
;y2 = 8
;z2 = 9
;a2 = 10
;b2 = 11
;c2 = 12

; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
