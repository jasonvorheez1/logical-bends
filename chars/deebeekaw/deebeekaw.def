; Definition file for this guy
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Most_Mysterious"        ;Name of character
displayname = "Dee Bee Kaw" ;Name of character to display
versiondate = 09,15,2011    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "The_None"         ;Character author name
pal.defaults = 1,2,6,5,4,11,12,10,8,7,9

; Files for the player
[Files]
